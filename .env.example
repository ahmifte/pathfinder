# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Placeholders intentionally do not resemble real key formats, so they are never
# flagged as leaked secrets by scanners.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/pathfinder

# --- NextAuth ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_ID=
GITHUB_SECRET=

# --- Stripe ---
# Prefer a RESTRICTED key (rk_...) over a full secret key (sk_...). The key
# determines which Stripe account is used, so use your own account's key.
STRIPE_SECRET_KEY=your-stripe-restricted-or-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Note: there are NO price IDs here by design. Courses are defined in
# lib/courses.ts and provisioned with `pnpm stripe:sync`, then resolved at
# runtime by lookup_key. To run the sync, the key above needs write access to
# Products and Prices.

# Public base URL (used for Stripe redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
